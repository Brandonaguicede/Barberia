{
  "name": "barbershop-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/vite.mjs dev",
    "build": "tsc && node scripts/vite.mjs build",
    "preview": "node scripts/vite.mjs preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:db": "node --test tests/database.integration.mjs",
    "test:browser": "node --test tests/*.smoke.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "lucide-react": "1.45.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "oxlint": "1.82.0",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vite": "5.4.21"
  }
}
